   <main>

      <div class="bg-r bg-p-center bg-s-cover fv relative"> <!-- ファーストビュー -->

         <div class="deco-sun bg-r bg-p-center bg-s-contain"></div>
         <div class="deco-mt bg-r bg-p-center bg-s-contain"></div>

         <div class="bg-switcher bg-r bg-p-center bg-s-contain anime-ster" data-interval="2"
            data-images='["img/anime/star-1.png","img/anime/star-2.png"]'></div> <!-- 星のアニメーション -->

         <h1><img src="img/head/main-title.png" alt=""><span class="visually-hidden">日本勤労者山岳連盟</span></h1>

      </div>

      <section class="content topics relative"> <!-- トピックス -->

         <div class="absolute bg-p-center bg-r bg-s-contain cloud"></div>

         <h2 class="absolute">
            <picture>
               <source media="(min-width:1000px)" srcset="img/top/title/title-topics-pc.png">
               <img src="img/top/title/title-topics-sp.png" alt="">
            </picture>
            <span class="visually-hidden">トピックス</span>
         </h2>

         <div class="tabs">
            <ul class="tab-buttons flex">
               <li class="active" data-tab="panel1">新着情報⁨⁨⁨</li>
               <li data-tab="panel2">活動紹介</li>
               <li data-tab="panel3">magazine</li>
            </ul>

            <div class="tab-contents">
               <div id="panel1" class="tab-panel active"> <!-- 新着タブ --></div>

               <div id="panel2" class="tab-panel"> <!-- 活動紹介タブ --></div>

               <div id="panel3" class="tab-panel"> <!-- magazine --></div>

            </div>
         </div>


         <p class="more flex"><a href="content" class="bg-r bg-s-cover flex"><img src="img/top/button/top-more.png"
                  alt=""><span class="visually-hidden">もっと見る</span></a></p>

      </section>

      <div class="flex layout">

         <section class="content box card relative federation-card"> <!-- 全国連盟の動き -->

            <div class="absolute bg-switcher bg-r bg-p-center bg-s-contain anime-bare" data-interval="2"
               data-images='["img/anime/bare-1.png","img/anime/bare-2.png"]'></div> <!-- クマのアニメーション -->

            <div class="absolute bg-p-center bg-r bg-s-contain cloud"></div>

            <h2 class="absolute">
               <picture>
                  <source media="(min-width:1000px)" srcset="img/top/title/title-nationwide-pc.png">
                  <img src="img/top/title/title-nationwide-sp.png" alt="">
               </picture>
               <span class="visually-hidden">全国連盟の動き</span>
            </h2>

            <div class="flex column">

               <div class="card-txt">
                  <p>全国自然保護担当者会議<br>11月14日～15日（近畿地方（開催地未定））</p>
               </div>
               <div class="card-ph"><img src="img/top/link/260910_01.jpg"></div>
               <p class="more flex"><a href="05activities/japan/" class="bg-r bg-s-cover flex"><img
                        src="img/top/button/top-more.png" alt=""><span class="visually-hidden">もっと見る</span></a></p>
            </div>

         </section>

         <section class="content box card exchange-card relative"> <!-- 交流集会 -->

            <div class="absolute bg-p-center bg-r bg-s-contain cloud"></div>

            <h2 class="absolute">
               <picture>
                  <source media="(min-width:1000px)" srcset="img/top/title/title-alternating-pc.png">
                  <img src="img/top/title/title-alternating-sp.png" alt="">
               </picture>
               <span class="visually-hidden">交流集会</span>
            </h2>

            <div class="flex column">
               <div class="card-txt">
                  <p>全国組織拡大経験交流集会<br>10月3日
                     （全国連盟事務所オンライン・東京）</p>
               </div>
               <div class="card-ph"><img src="img/top/link/260910_02.jpg"></div>
               <p class="more flex"><a href="05activities/japan/" class="bg-r bg-s-cover flex"><img
                        src="img/top/button/top-more.png" alt=""><span class="visually-hidden">もっと見る</span></a></p>

            </div>

         </section>

      </div>

      <section class="content box card raicho-card relative"> <!-- らいちょう -->

         <div class="absolute bg-p-center bg-r bg-s-contain cloud"></div>

         <h2 class="absolute">
            <picture>
               <source media="(min-width:1000px)" srcset="img/top/title/title-raicho-pc.png">
               <img src="img/top/title/title-raicho-sp.png" alt="">
            </picture>
            <span class="visually-hidden">らいちょう情報</span>
         </h2>

         <div class="flex column">
            <div class="card-txt">
               <p>らいちょうの目撃情報を募集しています。<br>お見かけの際は、ぜひ、ご一報ください。<br>らいちょうの様子をみんなで見守りましょう。</p>
            </div>
            <div class="card-ph"><img src="img/top/thumbnail/raicho-thumbnail.jpg" alt=""></div>
         </div>
         <p class="more flex"><a href="raicho/" class="bg-r bg-s-cover flex"><img src="img/top/button/top-more.png"
                  alt=""><span class="visually-hidden">もっと見る</span></a></p>

      </section>

